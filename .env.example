# Server Configuration
PORT=8080
TIMEOUT=3600000

# CORS Settings
CORS_ORIGIN=*
CORS_HEADERS=*

# Browser Configuration
BROWSER_HEADLESS=true
DEFAULT_URL=https://www.tiktok.com/@rihanna?lang=en
USER_AGENT=Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_6) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/98.0.4758.109 Safari/537.36

# Proxy Configuration (optional)
# PROXY_URL=http://proxy.example.com:8080
# PROXY_URL=socks5://proxy.example.com:1080
# PROXY_URL=http://user:pass@proxy.example.com:8080

# Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_URL=https://www.tiktok.com/@rihanna?lang=en
MONITORING_INTERVAL=3600000
LOG_DIR=logs
